// plasma.fsr — AMD FidelityFX Super Resolution, Frame Generation, Ray Regeneration and Anti-Lag 2 for the engine's
// upscaler, frame generation, ray reconstruction and low-latency frameworks.
//
// The AUTHORED manifest, kept in source next to the plugin. Component hashes and sizes are NOT
// here: the packaging step computes those and emits them into the published manifest.
//
// Field reference and validation rules: Docs/PluginPackageManagerPlan.html §05.

PackageInfo
{
	string %Id{"plasma.fsr"}
	string %Version{"1.1.0"}
	string %Publisher{"PlasmaTechnology"}
	string %License{"MIT"}
	string %Homepage{"https://plasmagameengine.com"}

	string %MinEngineVersion{"0.12.2"}
	string %MaxEngineVersion{""}
	string %AbiTag{"win64-msvc19-0.12.2-abi7-dev"}

	string %DisplayName{"AMD FSR"}
	string %Category{"Rendering"}
	string %Description{"Adds AMD FidelityFX Super Resolution as a temporal upscaler (Rendering.Upscaler = FSR) on D3D12 and Vulkan. The driver runs FSR 4 on GPUs that support it and FSR 3.1 everywhere else. On D3D12 it also adds AMD FSR Frame Generation (Rendering.FrameGeneration = FSR, one generated frame per rendered frame, any GPU), AMD FSR Ray Regeneration (ray reconstruction for the FSR upscaler, Radeon RX 9000 series) and AMD Anti-Lag 2 (Rendering.LowLatency.Backend = AntiLag2, Radeon GPUs). Can be installed alongside the other upscaler and frame generation packages; the game settings choose between them. Third-party notice: ships AMD's signed FidelityFX runtime under the AMD FidelityFX licence (FidelityFX-LICENSE.txt)."}
	string %Icon{"Branding/FSRIcon.png"}
	string %Banner{"Branding/FSRBanner.png"}

	string %EditorPlugins{}
	string %EditorEnginePlugins{}
	string %RuntimePlugins{"plFSRPlugin"}
	// The FidelityFX runtime and its licence ride in the same component as the plugin.
	string %PackageDependencies{"amd_fidelityfx_loader_dx12", "amd_fidelityfx_upscaler_dx12", "amd_fidelityfx_framegeneration_dx12", "amd_fidelityfx_denoiser_dx12", "amd_fidelityfx_loader_vk", "amd_fidelityfx_upscaler_vk", "FidelityFX-LICENSE.txt"}

	Component { string %Name{"manifest"} string %Platform{"any"} }
	Component { string %Name{"runtime-win64"} string %Platform{"win64"} }
	Component { string %Name{"icon"} string %Platform{"any"} }
	Component { string %Name{"banner"} string %Platform{"any"} }
}
